{
  "name": "llm-eval-kit",
  "version": "0.1.0",
  "private": true,
  "description": "An automated quality engineering framework for testing, benchmarking, and regression-testing LLM applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "calibration:verify": "pnpm build && node scripts/verify-calibration.mjs",
    "provider:smoke": "pnpm build && node scripts/provider-smoke.mjs",
    "portfolio:verify": "pnpm build && node scripts/verify-portfolio.mjs",
    "benchmark:mock": "vitest run packages/core/test/performance.test.ts",
    "studio:api": "pnpm --filter @llm-eval-kit/studio-api build && pnpm --filter @llm-eval-kit/studio-api start",
    "studio:web": "pnpm --filter @llm-eval-kit/studio-web dev",
    "release:verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm calibration:verify && node scripts/verify-portfolio.mjs && node scripts/provider-smoke.mjs && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
