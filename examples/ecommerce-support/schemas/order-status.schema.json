{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["orderId", "status"],
  "additionalProperties": false,
  "properties": {
    "orderId": { "type": "string", "pattern": "^ORDER-[0-9]+$" },
    "status": { "enum": ["processing", "shipped", "delivered", "cancelled"] }
  }
}
